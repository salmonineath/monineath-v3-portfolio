# Public URL of the deployed site (canonical URL, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional. Server-only endpoint that receives contact form submissions as JSON
# ({ name, email, message }), e.g. a Formspree form endpoint. When unset, the
# form opens the visitor's email app with the message drafted instead.
CONTACT_WEBHOOK_URL=
